# Copie para .env e ajuste se necessário. Nenhuma variável é obrigatória.

# Parte 1 - GitHub: com token o limite sobe de 60 para 5000 req/h
GITHUB_TOKEN=

# Parte 1 - ReqRes: chave de conta gratuita (app.reqres.in). Sem ela vale a cota anônima de 40 req/dia por IP
# (a suíte usa ~10 por execução; esgotada, os testes do ReqRes são pulados com o motivo).
REQRES_API_KEY=

# Parte 1 - TTL simulado do token opaco do ReqRes em ms (padrão: 120000 = 2 min)
TOKEN_TTL_MS=

# Parte 2 - Reproduz exatamente a massa de dados de uma execução anterior
FAKER_SEED=
